AZURE_SUBSCRIPTION_ID=e2d35239-5448-45ae-b156-d3309a9052a9
AZURE_RESOURCE_GROUP=Aakash_ML
AZURE_WORKSPACE_NAME=Aakash_ML

# Compute name from Azure ML Studio (Attached compute tab)
AZURE_COMPUTE_NAME=gpu-vm-clean

# Dataset details
AZURE_DATASET_NAME=car_parts_seg_dataset
AZURE_DATASET_VERSION=1

# ──────────────────────────────────────────────────────────────
# Training Hyperparameters (Used by train.py)
# ──────────────────────────────────────────────────────────────
# NOTE: All TRAIN_* variables (EPOCHS, BATCH, IMGSZ, etc.) have been
# removed. The new Rust orchestrator manages hyperparameters interactively
# and passes them as CLI arguments (e.g. --epochs, --batch).
# azure_train.py will explicitly require these arguments and will not
# read them from this .env file to prevent silent overrides.
